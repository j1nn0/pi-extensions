{
  "name": "@j1nn0/pi-input-lock",
  "version": "0.2.1",
  "description": "Automatically locks Pi's interactive input while an agent is running.",
  "keywords": [
    "input-lock",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "safety",
    "watch"
  ],
  "license": "MIT",
  "author": "j1nn0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j1nn0/pi-extensions.git",
    "directory": "packages/pi-input-lock"
  },
  "bugs": {
    "url": "https://github.com/j1nn0/pi-extensions/issues"
  },
  "homepage": "https://github.com/j1nn0/pi-extensions/tree/main/packages/pi-input-lock#readme",
  "files": [
    "src",
    "index.ts",
    "README.md",
    "README.ja.md",
    "CHANGELOG.md",
    "LICENSE",
    "pi-input-lock.schema.json"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:check": "pnpm pack --pack-destination /tmp",
    "smoke:pty": "node scripts/pty-smoke.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.0.0",
    "@earendil-works/pi-coding-agent": ">=1.0.0",
    "@earendil-works/pi-tui": ">=1.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
